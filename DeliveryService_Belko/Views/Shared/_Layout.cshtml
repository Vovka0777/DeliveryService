<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DeliveryService</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login_and_registration.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/media_style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DeliveryService_Belko.styles.css" asp-append-version="true" />
</head>

<body>
    <div id="header-top">
        <a href="/" class="logo">
            Брэгд<span style="color:var(--primary-color)">.</span>
        </a>

        <div class="menu">
            <ul>
                <li><a href="/#home">Главная</a></li>
                <li><a href="/#services">Услуги</a></li>
                <li><a href="/#contacts">Контакты</a></li>
                <li><a asp-controller="Catalog" asp-action="Index">Каталог</a></li>
            </ul>
        </div>

        <div class="button-header d-flex align-items-center">
            <button id="theme-toggle" class="btn-theme me-3" type="button" title="Переключить тему">
                <i class="bi bi-moon"></i>
            </button>

            @if (User.Identity.IsAuthenticated)
            {
                <div class="dropdown">
                    <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUserMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@User.FindFirst("AvatarPath")?.Value" asp-append-version="true"
                             alt="Avatar"
                             class="rounded-circle me-2"
                             style="width: 35px; height: 35px; object-fit: cover;">
                        <span class="fw-bold text-color me-2">@User.Identity.Name</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownUserMenu" style="border-radius: 12px; border: none; overflow: hidden;">
                        <li><a class="dropdown-item py-2" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i> Профиль</a></li>
                        <li><a class="dropdown-item py-2" asp-controller="Cart" asp-action="Index"><i class="bi bi-cart me-2"></i> Корзина</a></li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Админ панель</a></li>
                        }

                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item py-2 text-danger" type="button" onclick="window.location.href ='@Url.Action("Logout", "Home")'">
                                <i class="bi bi-box-arrow-right me-2"></i> Выйти
                            </button>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <button class="button" id="click-to-hide" type="button">
                    <i class="bi bi-person-circle"></i> Войти
                </button>
            }
        </div>

        <div id="hamburger" class="icon">
            <i class="bi bi-list"></i>
        </div>
    </div>

    @await Html.PartialAsync("_LoginRegistrationPartial")

    <div id="menu-overlay" class="menu-overlay"></div>
    <div id="side-menu" class="side-menu">
        <div class="side-menu-header">
            <div class="logo">Брэгд.</div>
            <button id="close-menu-btn" class="close-btn">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="side-menu-content">
            <ul class="nav-list">
                <li><a href="/"><i class="bi bi-house-door"></i> Главная</a></li>
                <li><a asp-controller="Catalog" asp-action="Index"><i class="bi bi-shop"></i> Каталог</a></li>
                @if (User.Identity.IsAuthenticated)
                {
                    <li><a asp-controller="Cart" asp-action="Index"><i class="bi bi-cart"></i> Корзина</a></li>
                    <li><a asp-controller="Profile" asp-action="Index"><i class="bi bi-person-badge"></i> Профиль</a></li>

                    @if (User.IsInRole("Admin"))
                    {
                        <li><a asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> Админ панель</a></li>
                    }
                }
                <li><a href="/#services"><i class="bi bi-lightning"></i> Услуги</a></li>
                <li><a href="/#contacts"><i class="bi bi-telephone"></i> Контакты</a></li>
            </ul>
            <div class="side-menu-footer">
                <div class="theme-switch-wrapper">
                    <span>Тема:</span>
                    <button id="theme-toggle-mobile" class="btn-theme-mobile" type="button">
                        <i class="bi bi-moon"></i>
                    </button>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    <button class="button w-100 mt-3" onclick="window.location.href ='@Url.Action("Logout", "Home")'">
                        <i class="bi bi-box-arrow-right"></i> Выйти
                    </button>
                }
                else
                {
                    <button id="open-login-side" class="button w-100 mt-3">
                        <i class="bi bi-person"></i> Войти / Регистрация
                    </button>
                }
            </div>
        </div>
    </div>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_FooterPartial")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/shared_script.js" asp-append-version="true"></script>
    <script src="~/js/login_and_registration_script.js" asp-append-version="true"></script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>