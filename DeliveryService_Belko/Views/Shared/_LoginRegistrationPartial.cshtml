<div class="form-box">
	<form class="form form_signin">
		<h3 class="form_title">Вход</h3>

		<label id="email">
			<input type="text" />
			<span>Почта</span>
		</label>

		<label id="password">
			<input type="password" />
			<span>Пароль</span>
		</label>

		<div class="form-btn">Войти</div>
	</form>

	<form class="form form_signup">
		<h3 class="form_title">Регистрация</h3>

		<label id="login">
			<input type="text" />
			<span>Логин</span>
		</label>

		<label id="email">
			<input type="text" />
			<span>Почта</span>
		</label>

		<label id="password">
			<input type="password" />
			<span>Пароль</span>
		</label>

		<label id="confirm_password">
			<input type="password" />
			<span>Подтвердите пароль</span>
		</label>

		<div class="form-btn form_btn_signup">Зарегистрироваться</div>
	</form>
</div>
