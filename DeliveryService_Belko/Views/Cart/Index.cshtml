@model List<DeliveryService.Domain.Models.BasketItem>

@{
    ViewData["Title"] = "Корзина";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal totalSum = Model != null ? Model.Sum(x => x.Item.Price * x.Quantity) : 0;
}

<div class="container mt-5 fade-in">
    <div class="row">

        <div class="col-12 mb-4">
            <h2 class="fw-bold text-color">
                <i class="bi bi-cart3 me-2 text-primary"></i>Корзина
                <span class="fs-5 text-muted ms-2">(@(Model?.Count ?? 0) товаров)</span>
            </h2>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="col-12 text-center py-5">
                <div class="mb-4">
                    <i class="bi bi-cart-x text-muted" style="font-size: 5rem; opacity: 0.5;"></i>
                </div>
                <h3 class="text-color fw-bold">Ваша корзина пуста</h3>
                <p class="text-muted mb-4">Но это легко исправить!</p>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-lg">
                    Перейти в каталог
                </a>
            </div>
        }
        else
        {
            <div class="col-lg-8">
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model)
                    {
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden cart-item-card">
                            <div class="card-body p-3">
                                <div class="row align-items-center g-3">

                                    <div class="col-3 col-md-2 text-center">
                                        <div class="img-wrapper rounded-3 bg-light d-flex align-items-center justify-content-center" style="height: 80px;">
                                            <img src="@item.Item.PathImg" alt="@item.Item.Name" class="img-fluid" style="max-height: 100%; object-fit: contain;">
                                        </div>
                                    </div>

                                    <div class="col-9 col-md-5">
                                        <h5 class="fw-bold text-color mb-1">@item.Item.Name</h5>
                                    </div>

                                    <div class="col-6 col-md-3 text-md-center">
                                        <span class="text-muted small d-block d-md-none mb-1">Количество:</span>
                                        <div class="d-inline-flex align-items-center bg-light rounded-pill px-3 py-1 border">
                                            <span class="fw-bold text-color">@item.Quantity шт.</span>
                                        </div>
                                    </div>

                                    <div class="col-6 col-md-2 text-end">
                                        <div class="fw-bold text-primary mb-2 fs-5">@item.Item.Price ₽</div>
                                        <a asp-action="Remove" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger border-0 rounded-circle" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <div class="card sticky-summary">
                    <div class="card-body">
                        <div class="card border-0 shadow-lg rounded-4 position-sticky top-0 summary-card" style="top: 100px; z-index: 10;">
                            <div class="card-body p-4">
                                <h4 class="fw-bold text-color mb-4">Сумма заказа</h4>

                                <div class="d-flex justify-content-between mb-3">
                                    <span class="text-muted">Товары (@Model.Count)</span>
                                    <span class="fw-bold text-color">@totalSum ₽</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="text-muted">Доставка</span>
                                    <span class="text-success fw-bold">Бесплатно</span>
                                </div>

                                <hr class="my-3 opacity-25">

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <span class="fs-5 fw-bold text-color">Итого</span>
                                    <span class="fs-4 fw-bolder text-primary">@totalSum ₽</span>
                                </div>

                                <a asp-controller="Order" asp-action="CreateOrder" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-blue pulse-btn">
                                    Перейти к оформлению
                                </a>

                                <div class="text-center mt-3">
                                    <small class="text-muted"><i class="bi bi-shield-lock me-1"></i>Безопасная оплата</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
        }
    </div>
</div>