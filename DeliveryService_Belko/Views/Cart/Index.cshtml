@model IEnumerable<DeliveryService.Domain.Models.BasketItem>
@{
    ViewData["Title"] = "Корзина";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal fullPrice = Model?.Sum(x => x.Item.Price * x.Quantity) ?? 0;
}

<div class="container mt-5">
    <h2 class="mb-4 fw-bold">Ваша корзина</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Корзина пуста</h4>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary mt-3 rounded-pill">Перейти в каталог</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="border-0 p-3 ps-4">Товар</th>
                                        <th class="border-0 p-3">Цена</th>
                                        <th class="border-0 p-3">Кол-во</th>
                                        <th class="border-0 p-3">Итого</th>
                                        <th class="border-0 p-3"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="p-3 ps-4">
                                                <div class="d-flex align-items-center">
                                                    <img src="@item.Item.PathImg" class="rounded-3 me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                                    <span class="fw-semibold">@item.Item.Name</span>
                                                </div>
                                            </td>
                                            <td class="p-3">@item.Item.Price ₽</td>
                                            <td class="p-3">
                                                <span class="badge bg-secondary rounded-pill">@item.Quantity</span>
                                            </td>
                                            <td class="p-3 fw-bold">@(item.Item.Price * item.Quantity) ₽</td>
                                            <td class="p-3 text-end pe-4">
                                                <a asp-action="Remove" asp-route-id="@item.Item.Id" class="text-danger">
                                                    <i class="bi bi-trash fs-5"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card shadow-sm border-0 rounded-4 bg-light">
                    <div class="card-body p-4">
                        <h4 class="fw-bold mb-4">Итого</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Товары (@Model.Count())</span>
                            <span>@fullPrice ₽</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="fw-bold fs-5">К оплате</span>
                            <span class="fw-bold fs-5 text-primary">@fullPrice ₽</span>
                        </div>
                        <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow">
                            Оформить заказ
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>