@model DeliveryService.Domain.ViewModels.Profile.ProfileViewModel

@{
    ViewData["Title"] = "Профиль";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Профиль пользователя</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Save" method="post" enctype="multipart/form-data">
                        <div class="row mb-4 align-items-center">
                            <div class="col-md-4 text-center">
                                <img src="@(Model.AvatarPath ?? "/images/user.png")"
                                     class="rounded-circle img-thumbnail mb-3"
                                     style="width: 150px; height: 150px; object-fit: cover;">
                                <input asp-for="Avatar" class="form-control form-control-sm" type="file">
                            </div>
                            <div class="col-md-8">
                                <h3 class="mb-1">@Model.Name</h3>
                                <p class="text-muted">@Model.Email</p>
                            </div>
                        </div>

                        <hr>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Age" class="form-label"></label>
                                <input asp-for="Age" class="form-control" />
                            </div>
                            <div class="col-12">
                                <label asp-for="Address" class="form-label"></label>
                                <input asp-for="Address" class="form-control" placeholder="Улица, дом, квартира" />
                            </div>
                        </div>

                        <div class="mt-4 text-end">
                            <button type="submit" class="btn btn-primary px-4">Сохранить изменения</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>