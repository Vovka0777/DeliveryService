@{
    ViewData["Title"] = "Информация о нас";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-3">

    <div class="text-center mb-5" style="animation: fadeInUp 0.8s ease;">
        <h2 class="display-5 fw-bold mb-4">Наши контакты</h2>
        <div class="row justify-content-center g-4">

            <div class="col-md-4">
                <div class="row-item h-100 py-4">
                    <i class="bi bi-envelope-at text-primary display-4 mb-3 d-block"></i>
                    <h3 class="h5 fw-bold">Email</h3>
                    <p class="text-muted">DeliveryServ@mail.ru</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="row-item h-100 py-4">
                    <i class="bi bi-telephone text-primary display-4 mb-3 d-block"></i>
                    <h3 class="h5 fw-bold">Телефон</h3>
                    <p class="text-muted">+ (373) 534-623-954</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="row-item h-100 py-4">
                    <i class="bi bi-geo-alt text-primary display-4 mb-3 d-block"></i>
                    <h3 class="h5 fw-bold">Адрес</h3>
                    <p class="text-muted">г. Тирасполь, ул. Старого 2<br>1 этаж</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-5 opacity-10">

    <div class="container-section" style="animation: fadeInUp 0.8s ease 0.2s backwards;">
        <h2 class="info-sections">О компании</h2>
        <p class="intro-text fs-5">
            Мы — служба доставки, которая заботится о каждом заказе. Скорость, надежность и безупречное качество — наши главные приоритеты.
        </p>

        <div class="row g-4 mt-4">
            <div class="col-md-6 col-lg-3">
                <div class="about-item h-100">
                    <i class="bi bi-box-seam text-primary fs-2 mb-3"></i>
                    <h3 class="feature-title h5">Все виды грузов</h3>
                    <p class="small text-muted">Доставляем всё: от документов до крупногабаритных грузов.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="about-item h-100">
                    <i class="bi bi-lightning-charge text-primary fs-2 mb-3"></i>
                    <h3 class="feature-title h5">Молниеносно</h3>
                    <p class="small text-muted">Гарантируем доставку точно в срок благодаря умной логистике.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="about-item h-100">
                    <i class="bi bi-phone text-primary fs-2 mb-3"></i>
                    <h3 class="feature-title h5">Отслеживание</h3>
                    <p class="small text-muted">Следите за курьером на карте в реальном времени через приложение.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="about-item h-100">
                    <i class="bi bi-people text-primary fs-2 mb-3"></i>
                    <h3 class="feature-title h5">Команда профи</h3>
                    <p class="small text-muted">Вежливые курьеры и заботливая поддержка 24/7.</p>
                </div>
            </div>
        </div>

        <div class="about-item centered mt-5 p-0 overflow-hidden shadow-sm" style="border: 4px solid #fff;">
            <div class="map position-relative" style="height: 450px; margin: 0; width: 100%;">
                <script type="text/javascript" charset="utf-8" async src="https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A6901c3237fc5cf4423a0207fce0c657578f7fbab4d0a6b1c3c92c01041d3fbd0&amp;width=100%25&amp;height=100%25&amp;lang=ru_RU&amp;scroll=true"></script>
            </div>
        </div>
    </div>

    <div class="container my-5 pb-5">
        <h2 class="info-sections">Напишите нам</h2>
            <p class="text-muted">Есть вопрос или предложение? Заполните форму ниже.</p>
            <form class="message-text w-100">
                <div class="form-floating mb-3">
                    <textarea class="form-control" placeholder="" id="floatingTextarea2" style="height: 150px; border-radius: 15px; border: 2px solid #eef2f6;"></textarea>
                    <label for="floatingTextarea2">Ваше сообщение</label>
                </div>
                <div class="message-button">
                    <button class="button" type="submit">Отправить сообщение</button>
                </div>
            </form>
    </div>

</div>