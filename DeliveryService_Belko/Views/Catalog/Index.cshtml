@* 1. Меняем тип модели на CatalogViewModel *@
@model DeliveryService.Domain.ViewModels.Catalog.CatalogViewModel

@{
    ViewData["Title"] = "Каталог товаров";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="text-center mb-4">
    <h1 class="display-4">Каталог</h1>
</div>

<div class="catalog-wrapper">
    <div class="filters-sidebar">
        <h4 class="mb-3">Фильтры</h4>
        <div class="filter-group">
            <label class="form-label">Максимальная цена: <span id="priceValue">5000</span> ₽</label>
            <input type="range" class="form-range" min="0" max="5000" step="50" value="5000" id="priceRange">
        </div>
        <div class="filter-group">
            <h5 class="mt-3">Категория</h5>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="0" id="catFood">
                <label class="form-check-label" for="catFood">Еда</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="1" id="catStationery">
                <label class="form-check-label" for="catStationery">Канцелярия</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="2" id="catBuild">
                <label class="form-check-label" for="catBuild">Стройматериалы</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="3" id="catClothes">
                <label class="form-check-label" for="catClothes">Одежда</label>
            </div>
        </div>
        <button id="applyFilters" class="btn btn-primary w-100 mt-3">Применить</button>
    </div>

    <div class="products-content">
        <div class="sort-bar mb-3">
            <label for="sortOrder" class="me-2">Сортировка:</label>
            <select id="sortOrder" class="form-select d-inline-block w-auto">
                <option value="default">По умолчанию</option>
                <option value="price_asc">Сначала дешевые</option>
                <option value="price_desc">Сначала дорогие</option>
                <option value="name_asc">По названию (А-Я)</option>
            </select>
        </div>

        <div class="catalog-container" id="productsList">
            @* 2. Проверяем Model.Items, а не саму Model *@
            @if (Model.Items == null || !Model.Items.Any())
            {
                <p class="text-center">Товары не найдены.</p>
            }
            else
            {
                @* 3. Перебираем Model.Items *@
                @foreach (var item in Model.Items)
                {
                    <div class="product-card">
                        <div class="card-img-container">
                            <img src="@item.PathImg" alt="@item.Name" class="product-img" />
                        </div>

                        <div class="card-body">
                            <h3 class="card-title">@item.Name</h3>
                            <span class="badge bg-secondary mb-2">Категория: @item.Category</span>
                            <p class="card-text">@item.Description</p>

                            <div class="card-footer-custom">
                                <span class="price-tag">@item.Price ₽</span>
                                <a asp-controller="Catalog" asp-action="GetItem" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    Купить
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    const priceRange = document.getElementById('priceRange');
    const priceValue = document.getElementById('priceValue');
    if(priceRange) {
        priceRange.addEventListener('input', function() {
            priceValue.textContent = this.value;
        });
    }
</script>
<script src="~/js/catalog.js" asp-append-version="true"></script>