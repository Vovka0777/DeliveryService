@model DeliveryService.Domain.ViewModels.Catalog.CatalogViewModel

@{
    ViewData["Title"] = "Каталог товаров";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 pt-3">
    <div class="text-center mb-5" style="animation: fadeInUp 0.8s ease;">
        <h1 class="display-4 fw-bold">Наш каталог</h1>
        <p class="text-muted lead">Выберите лучшие товары по отличным ценам</p>
    </div>

    <div class="search-box mb-5 mx-auto" style="max-width: 700px; animation: fadeInUp 0.8s ease 0.1s backwards;">
        <input type="text" id="elasticSearch" class="search-input" placeholder="Я ищу...">
        <i class="bi bi-search search-icon"></i>
        <span class="clear-search" id="clearSearch" style="display:none; position:absolute; right: 55px; top:50%; transform:translateY(-50%); cursor:pointer; font-size:1.5rem;">&times;</span>
    </div>

    <div class="catalog-wrapper">

        <aside class="filters-sidebar">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="m-0 fw-bold">Фильтры</h4>
                <i class="bi bi-sliders text-primary"></i>
            </div>

            <hr class="mb-4 text-muted">

            <div class="filter-group">
                <label class="form-label d-flex justify-content-between fw-semibold">
                    Цена до: <span class="text-primary" id="priceValue">5000</span> ₽
                </label>
                <input type="range" class="form-range" min="0" max="10000" step="100" value="5000" id="priceRange">
            </div>

            <div class="filter-group mt-4">
                <h5 class="mb-3 fw-semibold fs-6 text-uppercase text-muted">Категории</h5>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" value="0" id="catFood">
                    <label class="form-check-label" for="catFood">Еда</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" value="1" id="catStationery">
                    <label class="form-check-label" for="catStationery">Канцелярия</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" value="2" id="catBuild">
                    <label class="form-check-label" for="catBuild">Стройматериалы</label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" value="3" id="catClothes">
                    <label class="form-check-label" for="catClothes">Одежда</label>
                </div>
            </div>

            <button id="applyFilters" class="btn btn-primary w-100 mt-4 rounded-pill py-2 fw-bold shadow-sm">
                Применить
            </button>
        </aside>

        <section class="products-content">

            <div class="sort-bar">
                <div class="d-flex align-items-center">
                    <label for="sortOrder" class="me-2 text-muted small text-uppercase fw-bold">Сортировка:</label>
                    <select id="sortOrder" class="form-select form-select-sm border-0 bg-light" style="width: auto; cursor: pointer;">
                        <option value="default">По умолчанию</option>
                        <option value="price_asc">Сначала дешевые</option>
                        <option value="price_desc">Сначала дорогие</option>
                        <option value="name_asc">По названию (А-Я)</option>
                    </select>
                </div>
            </div>

            <div class="catalog-container" id="productsList">
                @if (Model.Items == null || !Model.Items.Any())
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-basket display-1 text-muted mb-3 d-block"></i>
                        <h4 class="text-muted">Товары не найдены</h4>
                    </div>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <div class="product-card">
                            <div class="card-img-container">
                                <img src="@item.PathImg" alt="@item.Name" class="product-img" loading="lazy" />
                            </div>

                            <div class="card-body">
                                <h3 class="card-title">@item.Name</h3>
                                <p class="card-text">@item.Description</p>

                                <div class="card-footer-custom">
                                    <span class="price-tag">@item.Price ₽</span>
                                    <a asp-controller="Catalog" asp-action="GetItem" asp-route-id="@item.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                                        Подробнее
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>
    </div>
</div>