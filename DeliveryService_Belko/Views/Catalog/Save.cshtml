@model DeliveryService.Domain.ViewModels.Item.ItemViewModel
@using DeliveryService.Domain.Enum

@{
    ViewData["Title"] = Model.Id == Guid.Empty ? "Новый товар" : "Редактирование";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="admin-panel-container pt-5 pb-5">
    <div class="container" style="max-width: 700px;">

        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-icon me-3 text-white" style="background: rgba(255,255,255,0.1); border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="fw-bold m-0">@ViewData["Title"]</h2>
        </div>

        <form asp-action="Save" method="post" enctype="multipart/form-data" class="admin-form-card fade-in-up">
            <input asp-for="Id" hidden />
            <input asp-for="PathImg" hidden />

            <div class="row g-4">
                <div class="col-12">
                    <label asp-for="Name" class="admin-label">Название товара</label>
                    <input asp-for="Name" class="form-control admin-input" placeholder="Например: Набор карандашей" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Price" class="admin-label">Стоимость (₽)</label>
                    <input asp-for="Price" class="form-control admin-input" type="number" step="0.01" placeholder="0.00" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Category" class="admin-label">Категория</label>
                    <select asp-for="Category" class="form-select admin-input" asp-items="Html.GetEnumSelectList<ItemType>()"></select>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="admin-label">Описание</label>
                    <textarea asp-for="Description" class="form-control admin-input" rows="4" placeholder="Расскажите подробнее о товаре..."></textarea>
                </div>

                <div class="col-12">
                    <label class="admin-label">Изображение</label>
                    <div class="d-flex align-items-start gap-3">
                        @if (!string.IsNullOrEmpty(Model.PathImg))
                        {
                            <img src="@Model.PathImg" class="current-img-preview" />
                        }
                        <div class="flex-grow-1">
                            <input name="avatar" type="file" class="form-control admin-input" accept="image/*" />
                            <div class="text-muted x-small mt-2 ms-1" style="font-size: 0.75rem; opacity: 0.6;">
                                <i class="bi bi-info-circle me-1"></i> Рекомендуемый формат: JPG, PNG (500x500px)
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <button class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-lg mb-3" type="submit">
                        <i class="bi bi-check2-circle me-2"></i> Сохранить товар
                    </button>
                </div>
            </div>
        </form>

    </div>
</div>